rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Las imágenes del blog son públicas
    match /blog/{allPaths=**} {
      allow read;
    }

    // Regla específica para la carpeta 'images'.
    // Permite a los usuarios autenticados leer y escribir en esta carpeta.
    match /images/{allPaths=**} {
        allow read, write: if request.auth != null;
    }

    // Regla general para el resto de archivos.
    // Permite a los usuarios autenticados listar y leer, pero no escribir.
    // Esto es necesario para que la galería pueda listar los archivos.
    match /{allPaths=**} {
      allow list, read: if request.auth != null;
    }
  }
}
