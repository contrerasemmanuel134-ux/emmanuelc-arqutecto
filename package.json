{
  "name": "emmanuelc-arqutecto-root",
  "description": "Astro project",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "emulators": "firebase emulators:start --only functions,firestore,auth,storage,hosting --debug",
    "dev:functions": "cd functions && npm run watch",
    "dev:all": "run-p --silent dev emulators dev:functions"
  },
  "private": true,
  "dependencies": {
    "@astrojs/sitemap": "^3.5.1",
    "@astrojs/tailwind": "^6.0.2",
    "@google/generative-ai": "^0.24.1",
    "astro": "^5.13.5",
    "autoprefixer": "^10.4.21",
    "firebase": "^12.2.1",
    "tailwindcss": "^3.4.17",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "eslint": "^9.35.0",
    "eslint-plugin-astro": "^1.3.1",
    "npm-run-all": "^4.1.5",
    "typescript-eslint": "^8.43.0"
  }
}
