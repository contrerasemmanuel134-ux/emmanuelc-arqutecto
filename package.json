{
  "name": "emmanuelc-arqutecto-root",
  "description": "Astro project",
  "scripts": {
    "dev": "astro dev",
    "dev:agent": "cd agent-marketing/backend && export FIREBASE_CREDENTIALS=serviceAccountKey.json && python3 app.py",
    "dev:all": "npm-run-all --parallel dev emulators:essentials dev:agent",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "emulators": "firebase emulators:start --only functions,firestore,auth,storage,hosting --debug",
    "dev:functions": "cd functions && npm run build:watch",
    "emulators:essentials": "firebase emulators:start --only functions,firestore,auth,hosting,ui"
  },
  "private": true,
  "dependencies": {
    "@astrojs/node": "^9.4.6",
    "@astrojs/sitemap": "^3.6.0",
    "@astrojs/tailwind": "^6.0.2",
    "@google/generative-ai": "^0.24.1",
    "astro": "^5.14.1",
    "autoprefixer": "^10.4.21",
    "firebase": "^12.2.1",
    "firebase-admin": "^13.5.0",
    "tailwindcss": "^3.4.17",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "dotenv": "^17.2.2",
    "eslint": "^9.35.0",
    "eslint-plugin-astro": "^1.3.1",
    "npm-run-all": "^4.1.5",
    "typescript-eslint": "^8.43.0"
  },
  "workspaces": [
    "functions"
  ]
}
