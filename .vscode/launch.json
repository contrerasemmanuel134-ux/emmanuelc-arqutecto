{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Cloud Run: Run/Debug Locally",
      "type": "cloudcode.cloudrun",
      "request": "launch",
      "build": {
        "buildpacks": {
          "path": "package.json",
          "builder": "gcr.io/buildpacks/builder:v1"
        }
      },
      "image": "emmanuelc-arqutecto",
      "service": {
        "name": "emmanuelc-arqutecto",
        "containerPort": 8080,
        "resources": {
          "limits": {
            "memory": "256Mi"
          }
        }
      },
      "target": {
        "minikube": {}
      },
      "watch": true
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Astro: Launch App",
      "program": "${workspaceFolder}/node_modules/.bin/astro",
      "args": [
        "dev"
      ],
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "http://localhost:4321",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
