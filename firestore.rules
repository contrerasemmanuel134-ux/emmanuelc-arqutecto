rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Reglas de Lectura Pública para SSG (Static Site Generation) ---
    match /blog/{postId} { allow read: if true; allow write: if request.auth != null; }
    match /posts/{postId} { allow read: if true; allow write: if request.auth != null; }
    match /proyectos/{proyectoId} { allow read: if true; allow write: if request.auth != null; }
    match /servicios/{servicioId} { allow read: if true; allow write: if request.auth != null; }
    match /config/{configId} { allow read: if true; allow write: if request.auth != null; }
    match /pages/{pageId} { allow read: if true; allow write: if request.auth != null; }
    match /proceso/{pasoId} { allow read: if true; allow write: if request.auth != null; }

    // --- Reglas con Lógica Específica ---
    match /testimonios/{testimonioId} {
      allow create: if request.resource.data.nombreCliente is string
                      && request.resource.data.textoTestimonio is string
                      && request.resource.data.calificacion is number
                      && request.resource.data.estado == "pendiente";

      allow read: if request.auth != null || resource.data.estado == 'aprobado';
      allow update, delete: if request.auth != null; // Solo admin
    }

    // --- Regla para Otras Colecciones ---
    // Cualquier otra colección de primer nivel no definida anteriormente 
    // requerirá autenticación. Es más seguro que /{document=**}.
    match /{collection}/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
