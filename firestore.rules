rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Proyectos: Cualquiera puede leer. Nadie puede escribir directamente.
    match /proyectos/{proyectoId} {
      allow read: if true;
      allow write: if false; // Bloqueamos la escritura directa. Solo la API puede escribir.
    }

    // Blog: Cualquiera puede leer. Nadie puede escribir directamente.
    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if false; // Bloqueamos la escritura directa. Solo la API puede escribir.
    }

    // Testimonios: Reglas más complejas para un formulario público.
    // Se mantienen sin cambios ya que no son gestionados por la API del dashboard.
    match /testimonios/{testimonioId} {
      // Cualquiera puede crear un testimonio (dejar una reseña)
      allow create: if request.resource.data.nombreCliente is string
                      && request.resource.data.textoTestimonio is string
                      && request.resource.data.calificacion is number
                      && request.resource.data.estado == "pendiente";

      // El admin puede leer todos, y el público solo los aprobados.
      allow read: if request.auth != null || resource.data.estado == 'aprobado';

      // El admin puede actualizar y borrar
      allow update, delete: if request.auth != null;
    }
  }
}

// Las reglas de Storage se mantienen igual por ahora, ya que la API no gestiona subida de archivos.
service firebase.storage {
  match /b/{bucket}/o {
    // Las imágenes del blog son públicas
    match /blog/{allPaths=**} {
      allow read;
    }

    // Otros archivos solo para usuarios autenticados
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
