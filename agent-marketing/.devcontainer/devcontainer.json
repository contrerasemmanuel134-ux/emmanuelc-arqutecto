{
  "name": "Unified App Dev Container",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "forwardPorts": [4321, 8080],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "astro-build.astro-vscode",
        "ms-vscode-remote.remote-containers"
      ]
    }
  },
  "postCreateCommand": "npm --prefix ./frontend install && pip install -r ./backend/requirements.txt"
}
