---
// src/layouts/Layout.astro (VERSIÓN FINAL Y CORRECTA)

// ¡AÑADE ESTAS DOS LÍNEAS!
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import AsistenteCliente from "../components/AsistenteCliente.astro";

// Y esta para tus estilos, que ya tenías
import "../styles/main.css";

// El resto de tu código de props...
export interface Props {
    title: string;
    description?: string;
    showFooter?: boolean;
}
const {
    title,
    description = "Descripción por defecto",
    showFooter = true,
} = Astro.props;
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="icon" type="image/png" href="/favicon-16x16.png" />
        <!-- Google tag (gtag.js) -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-D1ZYSQ6PFZ"></script>
        <script>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());

          gtag('config', 'G-D1ZYSQ6PFZ');
        </script>
        <slot name="head" />
    </head>

    <body>
        <noscript
            ><iframe
                src="https://www.googletagmanager.com/ns.html?id=GTM-NNJ8BG7H"
                height="0"
                width="0"
                style="display:none;visibility:hidden"></iframe></noscript
        >

        {/* Y aquí los usas con la Mayúscula */}
        <Header />
        <main>
            <slot />
        </main>
        {showFooter && <Footer />}
        <AsistenteCliente />
        <script is:inline src="/assets/main.js"></script>
        <script is:inline src="/assets/js/animations.js"></script>
    </body>
