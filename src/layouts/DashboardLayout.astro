---
// src/layouts/DashboardLayout.astro
import "../styles/pages/_dashboard.css";
import TerminalAgente from "../components/TerminalAgente.astro"; // Importar el componente
export interface Props {
  title: string;
}
const { title } = Astro.props;

const navLinks = [
  { href: "/dashboard", name: "Resumen" },
  { href: "/dashboard/proyectos", name: "Proyectos" },
  { href: "/dashboard/reseñas", name: "Reseñas" },
  { href: "/dashboard/blog", name: "Blog" },
  { href: "/dashboard/media", name: "Media" },
  { href: "/dashboard/marketing", name: "Marketing" },
];

// Determina si la ruta actual es parte del dashboard
const isDashboardPage = (path: string) => path.startsWith("/dashboard");

// Comprueba si el enlace debe estar activo
const isActive = (linkHref: string, currentPath: string) => {
  if (linkHref === "/dashboard") {
    return currentPath === "/dashboard";
  }
  return currentPath.startsWith(linkHref);
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Dashboard</title>
    <link rel="icon" type="image/png" href="/favicon-16x16.png" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/easymde/dist/easymde.min.css"
    />
  </head>
  <body>
    <aside class="sidebar">
      <h1 class="sidebar__title">Admin Panel</h1>
      <nav class="sidebar-nav">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class:list={{
                active: isActive(link.href, Astro.url.pathname),
              }}
            >
              {link.name}
            </a>
          ))
        }
      </nav>
    </aside>

    <main class="main-content">
      <h1 class="text-3xl font-bold text-gray-800 mb-6">{title}</h1>
      <slot />
    </main>

    <!-- Terminal del Agente -->
    <TerminalAgente />
    
    <script>
      // Importa los scripts necesarios como módulos.
      // Esto asegura que compartan el mismo contexto y la instancia de Firebase inicializada.
      import "@/assets/js/app-terminal-agente.js";
    </script>
  </body>
</html>