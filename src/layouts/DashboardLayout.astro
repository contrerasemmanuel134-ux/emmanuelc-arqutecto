---
// src/layouts/DashboardLayout.astro
import "../styles/main.css";

export interface Props {
    title: string;
}
const { title } = Astro.props;

const navLinks = [
    { href: "/dashboard", name: "Resumen" },
    { href: "/dashboard/proyectos", name: "Proyectos" },
    { href: "/dashboard/testimonios", name: "Testimonios" },
    { href: "/dashboard/blog", name: "Blog" },
    { href: "/dashboard/media", name: "Media" },
];

// Determina si la ruta actual es parte del dashboard
const isDashboardPage = (path: string) => path.startsWith("/dashboard");

// Comprueba si el enlace debe estar activo
const isActive = (linkHref: string, currentPath: string) => {
    if (linkHref === "/dashboard") {
        return currentPath === "/dashboard";
    }
    return currentPath.startsWith(linkHref);
};
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title} | Dashboard</title>
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <style>
            :root {
                --sidebar-width: 250px;
                --sidebar-bg: #1f2937; /* gray-800 */
                --sidebar-link-text: #d1d5db; /* gray-300 */
                --sidebar-link-hover-bg: #374151; /* gray-700 */
                --sidebar-link-active-bg: #4b5563; /* gray-600 */
            }
            body {
                display: flex;
                background-color: #f3f4f6; /* gray-100 */
            }
            .sidebar {
                width: var(--sidebar-width);
                background-color: var(--sidebar-bg);
                color: white;
                padding: 1.5rem;
                height: 100vh;
                position: fixed;
                top: 0;
                left: 0;
            }
            .sidebar__title {
                font-size: 1.5rem;
                font-weight: bold;
                margin-bottom: 2.5rem;
                text-align: center;
            }
            .sidebar-nav a {
                display: block;
                color: var(--sidebar-link-text);
                padding: 0.85rem 1.25rem;
                border-radius: 0.375rem;
                text-decoration: none;
                margin-bottom: 0.75rem;
                transition:
                    background-color 0.2s,
                    color 0.2s;
            }
            .sidebar-nav a:hover {
                background-color: var(--sidebar-link-hover-bg);
                color: white;
            }
            .sidebar-nav a.active {
                background-color: var(--sidebar-link-active-bg);
                color: white;
                font-weight: 600;
            }
            .main-content {
                margin-left: var(--sidebar-width);
                padding: 2.5rem;
                width: calc(100% - var(--sidebar-width));
            }
        </style>
    </head>
    <body>
        <aside class="sidebar">
            <h1 class="sidebar__title">Admin Panel</h1>
            <nav class="sidebar-nav">
                {
                    navLinks.map((link) => (
                        <a
                            href={link.href}
                            class:list={{
                                active: isActive(link.href, Astro.url.pathname),
                            }}
                        >
                            {link.name}
                        </a>
                    ))
                }
            </nav>
        </aside>

        <main class="main-content">
            <div class="bg-white p-8 rounded-lg shadow-md">
                <h1 class="text-3xl font-bold text-gray-800 mb-6">{title}</h1>
                <slot />
            </div>
        </main>

        <script type="module" src="/assets/js/admin-auth.js"></script>
    </body>
</html>
