---
import Layout from "../layouts/Layout.astro";
import { db } from "@/firebase/client";
import { collection, getDocs, query, limit, doc, getDoc } from "firebase/firestore";
import { Image } from "astro:assets";

const title = "Emmanuel Contreras - Arquitectura Digital, Diseño Web y Diseño UX";
const description =
    "Convierto tu visión de negocio en plataformas digitales robustas y que generan resultados. Como Arquitecto Digital, construyo soluciones web a medida.";

// Fetch services
const q = query(collection(db, "servicios"), limit(3));
const serviciosSnapshot = await getDocs(q);
const servicios = serviciosSnapshot.docs.map((doc) => ({
    id: doc.id,
    ...doc.data(),
}));

// Fetch hero image from config
const configRef = doc(db, "config", "website");
const configSnap = await getDoc(configRef);
const configData = configSnap.data();
const heroImageUrl = configData?.heroSection?.imageUrl || '';
---

<Layout {title} {description}>
    <section class="hero-home" style={`background-image: url(${heroImageUrl})`}>
        <h1 class="hero-home__title">Emmanuel Contreras: Arquitecto Digital</h1>
        <p class="text-xl max-w-2xl mx-auto opacity-90 mb-10">
            Convierto tu visión de negocio en plataformas digitales robustas,
            intuitivas y que generan resultados medibles.
        </p>
        <div class="flex justify-center gap-4 flex-wrap">
            <a href="/proceso" class="button button--secondary"
                >Ver Mi Proceso</a
            >
            <a href="/contacto" class="button button--primary">Hablemos</a>
        </div>
    </section>
    <section class="page-section fade-in-section mt-20 mb-20">
        <div class="container text-center mx-auto">
            <h2 class="text-3xl font-bold text-gray-800 mb-4">
                De la Estrategia a la Realidad Digital
            </h2>
            <p class="max-w-3xl mx-auto text-lg mb-12">
                Mi misión es tender un puente entre tus objetivos y la
                tecnología. No solo construyo sitios web; diseño y desarrollo
                activos digitales a medida que impulsan el crecimiento.
            </p>
            <div class="grid md:grid-cols-3 gap-8">
                {
                    servicios.map((servicio) => (
                        <div class="service-card">
                            <Image
                                src={servicio.imagenUrl}
                                alt={servicio.titulo}
                                width={400}
                                height={400}
                                densities={[1, 1.5, 2]}
                                class="service-card__image"
                            />
                            <div class="service-card__overlay">
                                <h3 class="service-card__title">
                                    {servicio.titulo}
                                </h3>
                                <p class="service-card__description">
                                    {servicio.descripcionCorta}
                                </p>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>
</Layout>