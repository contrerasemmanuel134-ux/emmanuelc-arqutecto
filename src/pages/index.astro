---
import Layout from "../layouts/Layout.astro";

const title = "Emmanuel Contreras - Arquitecto Digital";
const description =
    "Convierto tu visión de negocio en plataformas digitales robustas y que generan resultados. Como Arquitecto Digital, construyo soluciones web a medida.";
---

<Layout title={title} description={description}>
    <section class="hero-home">
        <h1 class="hero-home__title">Emmanuel Contreras: Arquitecto Digital</h1>
        <p class="text-xl max-w-2xl mx-auto opacity-90 mb-10">
            Convierto tu visión de negocio en plataformas digitales robustas,
            intuitivas y que generan resultados medibles.
        </p>
        <div class="flex justify-center gap-4 flex-wrap">
            <a href="/proceso" class="button button--secondary"
                >Ver Mi Proceso</a
            >
            <a href="/contacto" class="button button--primary">Hablemos</a>
        </div>
    </section>

    <section class="page-section">
        <div class="container text-center">
            <h2 class="text-3xl font-bold text-gray-800 mb-4">
                De la Estrategia a la Realidad Digital
            </h2>
            <p class="max-w-3xl mx-auto text-lg mb-12">
                Mi misión es tender un puente entre tus objetivos y la
                tecnología. No solo construyo sitios web; diseño y desarrollo
                activos digitales a medida que impulsan el crecimiento.
            </p>
            <div class="grid md:grid-cols-3 gap-8">
                <div class="p-6 text-center">
                    <div class="flex justify-center mb-4">
                        <img
                            src="https://firebasestorage.googleapis.com/v0/b/expanded-system-469904-v9.firebasestorage.app/o/Un-diagrama-de-arquitectura-de-software-profesional-y-limpio.webp?alt=media&token=be7c7448-79c1-43e6-8b45-47f1f4aad1d6"
                            alt="Diagrama de estrategia digital"
                            width={200}
                            height={150}
                            class="rounded-lg shadow-lg"
                        />
                    </div>
                    <h3 class="text-xl font-bold text-gray-800 mb-2">
                        Estrategia Digital
                    </h3>
                    <p>
                        Análisis, planificación y definición de KPIs para
                        asegurar que el proyecto esté alineado con tus metas.
                    </p>
                </div>

                <div class="p-6 text-center">
                    <div class="flex justify-center mb-4">
                        <img
                            src="https://firebasestorage.googleapis.com/v0/b/expanded-system-469904-v9.firebasestorage.app/o/Un-_mockup_-fotorrealista-que-muestra-una-aplicaci%C3%B3n-web-sofisticada-y-elegante-desplegada-en-m%C3%BAltip.webp?alt=media&token=94fc895d-95ee-4949-b2bf-adfc02fea510"
                            alt="Mockup de aplicación web en una laptop"
                            width={200}
                            height={150}
                            class="rounded-lg shadow-lg"
                        />
                    </div>
                    <h3 class="text-xl font-bold text-gray-800 mb-2">
                        Diseño UX/UI
                    </h3>
                    <p>
                        Creación de experiencias de usuario lógicas y diseños
                        visuales atractivos que fortalecen tu marca.
                    </p>
                </div>

                <div class="p-6 text-center">
                    <div class="flex justify-center mb-4">
                        <img
                            src="https://firebasestorage.googleapis.com/v0/b/expanded-system-469904-v9.firebasestorage.app/o/Un-diagrama-de-arquitectura-de-software-profesional-y-limpio_1.webp?alt=media&token=5bcb8ddb-4ce6-466f-bd18-0678e4748ad7"
                            alt="Engranajes de precisión de un reloj"
                            width={200}
                            height={150}
                            class="rounded-lg shadow-lg"
                        />
                    </div>
                    <h3 class="text-xl font-bold text-gray-800 mb-2">
                        Desarrollo Web
                    </h3>
                    <p>
                        Código limpio, tecnologías modernas y un enfoque en el
                        rendimiento para una plataforma sólida y escalable.
                    </p>
                </div>
            </div>
        </div>
    </section>
</Layout>
