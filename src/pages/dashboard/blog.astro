---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
---

<DashboardLayout title="Dashboard | Blog">
  <main class="container">
    <p>Aquí puedes administrar los artículos de tu blog.</p>

    <button id="add-blog-btn" class="btn btn-primary">Crear Artículo</button>

    <div class="table-container">
      <table>
        <thead>
          <tr>
            <th>Título</th>
            <th>Categoría</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody id="blog-posts-table-body">
          <!-- El contenido se cargará dinámicamente con JavaScript -->
        </tbody>
      </table>
    </div>
  </main>

  <div id="postModal" class="modal">
    <div class="modal-content">
      <span class="close-btn">&times;</span>
      <h2 id="modal-title"></h2>
      <form id="post-form">
        <input type="hidden" id="post-id" />
        <div class="form-group">
          <label for="post-titulo">Título</label>
          <input type="text" id="post-titulo" required />
        </div>
        <div class="form-group">
          <label for="post-slug">URL (slug)</label>
          <input type="text" id="post-slug" required />
        </div>
        <div class="form-group">
          <label for="post-categoria">Categoría</label>
          <input type="text" id="post-categoria" required />
        </div>
        <div class="form-group">
          <label for="post-resumen">Resumen</label>
          <textarea id="post-resumen" rows="3"></textarea>
        </div>
        <div class="form-group">
          <label for="post-contenido">Contenido (Markdown)</label>
          <textarea id="post-contenido" rows="10"></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Guardar</button>
      </form>
    </div>
  </div>
</DashboardLayout>
