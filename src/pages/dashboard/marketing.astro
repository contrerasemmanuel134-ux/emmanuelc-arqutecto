---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Marketing y Analíticas">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="card">
            <h2 class="card-title">Rendimiento del Sitio (PageSpeed)</h2>
            <div id="pagespeed-data">Cargando...</div>
        </div>
        <div class="card">
            <h2 class="card-title">Visibilidad en Búsqueda (Search Console)</h2>
            <div id="search-console-data">Cargando...</div>
        </div>
        <div class="card">
            <h2 class="card-title">Tráfico Web (Analytics)</h2>
            <div id="analytics-data">Cargando...</div>
        </div>
        <div class="card">
            <h2 class="card-title">Rendimiento de Anuncios (Ads)</h2>
            <div id="ads-data">Cargando...</div>
        </div>
    </div>
</DashboardLayout>

<script>
    import "@/assets/app-marketing.js";
</script>
