---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
---

<DashboardLayout title="Dashboard | Proyectos">
  <main class="container">
    <p>
      Aquí puedes administrar los proyectos que se muestran en tu sitio web.
    </p>

    <button id="create-project-btn" class="btn btn-primary"
      >Crear Proyecto</button
    >

    <div class="table-container">
      <table>
        <thead>
          <tr>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody id="proyectos-table-body">
          <!-- El contenido se cargará dinámicamente con JavaScript -->
        </tbody>
      </table>
    </div>
  </main>

  <div id="createModal" class="modal">
    <div class="modal-content">
      <span class="close-btn" id="closeCreateModal">&times;</span>
      <h2>Crear Nuevo Proyecto</h2>
      <form id="create-project-form">
        <div class="form-group">
          <label for="create-name">Nombre del Proyecto</label>
          <input type="text" id="create-name" required />
        </div>
        <div class="form-group">
          <label for="create-description">Descripción</label>
          <textarea id="create-description" rows="3" required></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Guardar Proyecto</button>
      </form>
    </div>
  </div>

  <div id="editModal" class="modal">
    <div class="modal-content">
      <span class="close-btn" id="closeEditModal">&times;</span>
      <h2>Editar Proyecto</h2>
      <form id="edit-project-form">
        <input type="hidden" id="edit-id" />
        <div class="form-group">
          <label for="edit-name">Nombre del Proyecto</label>
          <input type="text" id="edit-name" required />
        </div>
        <div class="form-group">
          <label for="edit-description">Descripción</label>
          <textarea id="edit-description" rows="3" required></textarea>
        </div>
        <button type="submit" class="btn btn-primary"
          >Actualizar Proyecto</button
        >
      </form>
    </div>
  </div>
</DashboardLayout>
