---
import Layout from "../layouts/Layout.astro";
import "../styles/pages/_sobre-mi.css";
import { Image } from "astro:assets";
import { db } from "../firebase/client";
import { collection, getDocs, query, orderBy, doc, getDoc } from "firebase/firestore";

const title = "Sobre Mí - Emmanuel Contreras";
const description =
    "Hola, soy Emmanuel Contreras, un Arquitecto Digital. Mi pasión es ser el puente entre tus metas de negocio y la tecnología que necesitas para lograrlas.";

// Obtener datos de la sección "Sobre Mí"
const sobreMiDocSnap = await getDoc(doc(db, "sobreMi", "main"));
const sobreMi = sobreMiDocSnap.exists() ? sobreMiDocSnap.data() : null;

// Obtener pilares de la filosofía
const filosofiaSnapshot = await getDocs(query(collection(db, "filosofia"), orderBy("orden")));
const filosofia = filosofiaSnapshot.docs.map((doc) => doc.data());
---

<Layout title={title} description={description}>
    <section class="page-section">
        <div class="container">
            {
                sobreMi && (
                    <div class="about-hero">
                        <div class="about-hero__image-container">
                            <Image
                                src={sobreMi.imagenUrl}
                                alt="Retrato de Emmanuel Contreras"
                                class="about-hero__image"
                                width={400}
                                height={400}
                                densities={[1, 1.5, 2]}
                            />
                        </div>
                        <div class="about-hero__text">
                            <h1 class="about-hero__title">{sobreMi.titulo}</h1>
                            <p class="text-lg mt-4">{sobreMi.parrafo1}</p>
                            <p class="text-lg mt-2">{sobreMi.parrafo2}</p>
                        </div>
                    </div>
                )
            }
        </div>
    </section>

    <section class="page-section bg-light-gray">
        <div class="container text-center py-16 px-4 mx-auto">
            <h2 class="text-3xl font-bold text-gray-800 mb-4">
                Mi Filosofía de Trabajo
            </h2>
            <p class="max-w-3xl mx-auto text-lg mb-12">
                Mi proceso se fundamenta en tres pilares que garantizan el éxito
                de cada proyecto.
            </p>
            <div class="grid md:grid-cols-3 gap-8">
                {
                    filosofia.map((pilar) => (
                        <div class="service-card">
                            <Image
                                src={pilar.imagenUrl}
                                alt={pilar.titulo}
                                width={400}
                                height={400}
                                densities={[1, 1.5, 2]}
                                class="service-card__image"
                            />
                            <div class="service-card__overlay">
                                <h3 class="service-card__title">
                                    {pilar.titulo}
                                </h3>
                                <p class="service-card__description">
                                    {pilar.descripcion}
                                </p>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>
</Layout>