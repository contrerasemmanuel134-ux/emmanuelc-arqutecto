---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Dashboard de Contenidos">
    <main class="container mx-auto px-4 py-8">
        <h1 class="text-3xl font-bold text-gray-800 mb-6">
            Dashboard Estratégico
        </h1>

        <section
            id="kpi-container"
            class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-8"
        >
            <!-- KPIs se cargarán aquí -->
        </section>

        <nav class="bg-white shadow-sm rounded-t-lg">
            <div class="flex border-b">
                <button class="tab-button active" data-tab="proyectos"
                    >Proyectos</button
                >
                <button class="tab-button" data-tab="testimonios"
                    >Testimonios</button
                >
                <button class="tab-button" data-tab="blog">Blog</button>
            </div>
        </nav>

        <div class="bg-white p-6 rounded-b-lg shadow-sm">
            <div id="proyectos-panel" class="tab-panel active">
                <div class="flex justify-between items-center mb-4">
                    <h2 class="text-2xl font-bold text-gray-700">
                        Gestionar Proyectos
                    </h2>
                    <button
                        id="add-project-btn"
                        class="button button--primary"
                        >Añadir Proyecto</button
                    >
                </div>
                <div style="overflow-x:auto;">
                    <table class="dashboard-table">
                        <thead>
                            <tr>
                                <th>Proyecto</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="proyectos-body"></tbody>
                    </table>
                </div>
            </div>

            <div id="testimonios-panel" class="tab-panel">
                <h2 class="text-2xl font-bold text-gray-700 mb-4">
                    Gestionar Testimonios
                </h2>
                <div style="overflow-x:auto;">
                    <table class="dashboard-table">
                        <thead>
                            <tr>
                                <th>Cliente</th>
                                <th>Calificación</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="testimonios-body"></tbody>
                    </table>
                </div>
            </div>

            <div id="blog-panel" class="tab-panel">
                <div class="flex justify-between items-center mb-4">
                    <h2 class="text-2xl font-bold text-gray-700">
                        Gestionar Blog
                    </h2>
                    <button id="add-blog-btn" class="button button--primary"
                        >Añadir Artículo</button
                    >
                </div>
                <div style="overflow-x:auto;">
                    <table class="dashboard-table">
                        <thead>
                            <tr>
                                <th>Título</th>
                                <th>Categoría</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="blog-body"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>

    <div
        id="modal"
        class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4"
    >
        <div
            class="bg-white rounded-lg shadow-lg w-full max-w-2xl flex flex-col modal-container"
        >
            <div class="p-6 border-b">
                <h2 id="modal-title" class="text-2xl font-bold"></h2>
            </div>
            <div class="p-6 overflow-y-auto">
                <form id="modal-form"></form>
            </div>
            <div class="flex justify-end gap-4 p-6 border-t bg-gray-50">
                <button
                    type="button"
                    id="cancel-btn"
                    class="button button--secondary">Cancelar</button
                >
                <button
                    type="submit"
                    form="modal-form"
                    class="button button--primary">Guardar</button
                >
            </div>
        </div>
    </div>

    <script type="module" src="/assets/js/admin-auth.js"></script>
    <script type="module" src="/assets/js/app-dashboard-firestore.js"></script>
</Layout>