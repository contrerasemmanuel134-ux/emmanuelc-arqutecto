---
import BlogLayout from "../../layouts/BlogLayout.astro";
import { db } from "../../firebase/client";
import { collection, getDocs, query, orderBy } from "firebase/firestore";
import { Image } from "astro:assets";

// 1. Fetch all blog posts from Firestore
const postsSnapshot = await getDocs(
    query(collection(db, "blog"), orderBy("publishedDate", "desc"))
);
const posts = postsSnapshot.docs.map((doc) => doc.data());

// For now, we'll display the most recent post on this page.
const post = posts[0];

// This page can be updated later to list all posts, with each linking to a unique [slug].astro page.
if (!post) {
    return new Response("No hay posts en el blog.", { status: 404 });
}

const title = post.title;
const description = post.metaDescription;
---

<BlogLayout {title} {description}>
    <div class="p-6 md:p-12">
        <div class="container mx-auto bg-white rounded-xl shadow-lg p-6 md:p-10">
            <!-- Título del Artículo -->
            <h1 class="text-4xl md:text-5xl font-bold text-gray-900 leading-tight mb-4">
                {post.title}
            </h1>
            <p class="text-gray-500 mb-8 text-sm">
                Publicado el {new Date(post.publishedDate).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })} por <span class="text-gray-700 font-semibold">{post.author}</span>
            </p>

            <!-- Imagen principal -->
            <Image
                src={post.mainImageUrl}
                alt={`Imagen principal para ${post.title}`}
                width={1024}
                height={576}
                class="w-full h-auto rounded-lg mb-8 shadow-md"
            />

            <!-- Cuerpo del Blog Post -->
            <div
                class="prose max-w-none text-lg leading-relaxed text-gray-700"
                set:html={post.content}
            />
        </div>
    </div>
</BlogLayout>
