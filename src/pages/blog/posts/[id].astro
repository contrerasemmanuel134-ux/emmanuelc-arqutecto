---
import BlogLayout from "../../../layouts/BlogLayout.astro";
import { Image } from "astro:assets";
import placeholderImage from "../../../assets/development-gears.webp";
import { db } from "@/firebase/client";
import { collection, getDocs } from "firebase/firestore";

interface BlogPost {
  id: string;
  title: string;
  content: string;
  imageUrl: string;
}

export async function getStaticPaths() {
  const blogPostsSnapshot = await getDocs(collection(db, "blogPosts"));
  const paths = blogPostsSnapshot.docs.map((doc) => {
    const data = doc.data();
    return {
      params: { id: doc.id },
      props: { post: { id: doc.id, ...(data as BlogPost) } },
    };
  });
  return paths;
}

const { id } = Astro.params;
const { post } = Astro.props as { post: BlogPost };

const pageTitle = post?.title || "Blog Post";
const pageDescription = post?.content?.substring(0, 160) || "A blog post from Emmanuel Contreras.";
const imageUrl = post?.imageUrl || placeholderImage;
const imageAlt = post?.title || "Blog Post Image";
---

<BlogLayout title={pageTitle} description={pageDescription}>
  <section class="page-section">
    <div class="container prose lg:prose-xl mx-auto">
      <h1>{pageTitle}</h1>
      {
        imageUrl && (
          typeof imageUrl === 'string' ? (
            <img
              src={imageUrl}
              alt={imageAlt}
              class="w-full h-auto rounded-lg mb-8"
              width={1200}
              height={800}
            />
          ) : (
            <Image
              src={imageUrl}
              alt={imageAlt}
              class="w-full h-auto rounded-lg mb-8"
              width={1200}
              height={800}
            />
          )
        )
      }
      <p>{post?.content || "Content not available."}</p>
    </div>
  </section>
</BlogLayout>
