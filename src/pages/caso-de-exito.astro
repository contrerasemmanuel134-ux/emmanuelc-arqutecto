---
import Layout from "../layouts/Layout.astro";

const title = "Casos de Éxito - Emmanuel Contreras";
const description = "Explora cómo mis proyectos se traducen en resultados reales. Descubre casos de éxito de optimización SEO local y planos estratégicos para e-commerce.";

// NOTA: La lógica para cargar proyectos desde Firebase se movería aquí
// o se pasaría como prop desde un nivel superior. Por ahora, el contenedor está listo.
---

<Layout
    title={title}
    description={description}
>
    <section class="hero-interior">
        <h1 class="hero-interior__title">Casos de Éxito</h1>
        <p class="text-lg max-w-3xl mx-auto mt-4">
            Aquí puedes ver cómo la aplicación de una metodología estratégica y
            una ejecución técnica precisa se traducen en resultados reales y
            medibles.
        </p>
    </section>

    <section class="page-section">
        <div class="container">
            <div id="proyectos-publicos-container" class="portfolio-grid">
                <!-- El contenido se cargará aquí mediante JavaScript -->
            </div>
        </div>
    </section>

    <script src="../assets/app-proyectos-publicos.js"></script>
</Layout>
