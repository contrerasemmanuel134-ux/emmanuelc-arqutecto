---
import Layout from "../layouts/Layout.astro";
import { collection, getDocs, query, where } from "firebase/firestore";
import { db } from "../firebase/client";
import { Image } from "astro:assets";

interface Proyecto {
    title: string;
    description: string;
    imageUrl: string;
    urlSitioWeb?: string;
    urlRepositorio?: string;
    estado: string;
    tags?: string[];
}

const title = "Casos de Éxito - Emmanuel Contreras";
const description =
    "Explora cómo mis proyectos se traducen en resultados reales. Descubre casos de éxito de optimización SEO local y planos estratégicos para e-commerce.";

const q = query(
    collection(db, "proyectos"),
    where("estado", "==", "completado"),
);
const proyectosSnapshot = await getDocs(q);
const proyectos: (Proyecto & { id: string })[] = proyectosSnapshot.docs.map(
    (doc) => ({ id: doc.id, ...(doc.data() as Proyecto) }),
);
---

<Layout title={title} description={description}>
    <section class="page-section mt-20 mb-20">
        <div class="container">
            <div class="grid md:grid-cols-2 gap-8">
                {
                    proyectos.map((proyecto) => (
                        <a href={proyecto.urlSitioWeb} target="_blank" rel="noopener noreferrer" class="service-card">
                            <Image
                                src={proyecto.imageUrl}
                                alt={proyecto.title}
                                width={400}
                                height={400}
                                densities={[1, 1.5, 2]}
                                class="service-card__image"
                            />
                            <div class="service-card__overlay">
                                <h3 class="service-card__title">
                                    {proyecto.title}
                                </h3>
                                <p class="service-card__description">
                                    {proyecto.description}
                                </p>
                            </div>
                        </a>
                    ))
                }
            </div>
        </div>
    </section>
</Layout>
