---
import Layout from '../layouts/Layout.astro';
import { db } from '../firebase/client';
import { collection, getDocs, query, where } from 'firebase/firestore';

interface Testimonio {
    textoTestimonio: string;
    nombreCliente: string;
}

const title = "Reseñas y Testimonios - Emmanuel Contreras";
const description = "La confianza se construye con resultados. Lee los testimonios y reseñas de clientes que han transformado su negocio con mis servicios de arquitectura digital.";

const q = query(collection(db, "testimonios"), where("estado", "==", "aprobado"));
const testimoniosSnapshot = await getDocs(q);
const testimonios: (Testimonio & { id: string })[] = testimoniosSnapshot.docs.map(doc => ({ id: doc.id, ...(doc.data() as Testimonio) }));
---

<Layout
    title={title}
    description={description}
>
    <section class="hero-interior">
        <h1 class="hero-interior__title">La Voz de Mis Clientes</h1>
        <p class="text-lg max-w-3xl mx-auto mt-4">
            La confianza se construye con resultados. Mi mayor satisfacción es
            ver el impacto real que mi trabajo tiene en los negocios de mis
            clientes.
        </p>
    </section>

    <section class="page-section">
        <div class="container">
            <div class="testimonials-page-grid">
                {testimonios.map(testimonio => (
                    <div class="testimonial-card">
                        <p class="testimonial-card__text">"{testimonio.textoTestimonio}"</p>
                        <p class="testimonial-card__author">- {testimonio.nombreCliente}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>
</Layout>