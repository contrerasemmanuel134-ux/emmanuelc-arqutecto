---
import Layout from "../layouts/Layout.astro";
import PasoProceso from "../components/PasoProceso.astro";
import { db } from "../firebase/client";
import { collection, getDocs, query, orderBy } from "firebase/firestore";

const title = "Mi Proceso - Emmanuel Contreras";
const description =
    "Mi proceso probado de 4 fases (Descubrimiento, Diseño, Desarrollo y Lanzamiento) garantiza que tu proyecto se construya sobre cimientos sólidos y tenga éxito.";

const procesoSnapshot = await getDocs(query(collection(db, "proceso"), orderBy("fase")));
const procesos = procesoSnapshot.docs.map((doc) => doc.data());
---

<Layout title={title} description={description}>
    <section class="hero-interior">
        <h1 class="hero-interior__title">
            Nuestro Proceso: De la Idea a un Activo Digital de Alto Impacto
        </h1>
        <p class="text-lg max-w-3xl mx-auto mt-4">
            Los grandes resultados no son producto de la casualidad, sino de un
            proceso disciplinado. Este es el mapa que seguiremos juntos para
            construir tu proyecto sobre cimientos sólidos.
        </p>
    </section>
    <section class="page-section">
        <div class="container max-w-3xl mx-auto">
            {
                procesos.map((proceso, index) => (
                    <PasoProceso
                        stepNumber={`0${proceso.fase}`}
                        title={proceso.titulo}
                        description={proceso.descripcion}
                        isLast={index === procesos.length - 1}
                    />
                ))
            }
        </div>
    </section>
</Layout>