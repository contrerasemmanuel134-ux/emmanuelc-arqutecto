---
import Layout from '../layouts/Layout.astro';
import { collection, getDocs } from 'firebase/firestore';
const { getFirebaseFirestore } = await import('../firebase/client');
const db = await getFirebaseFirestore();

interface BlogPost {
  id: string;
  title: string;
  content: string;
  imageUrl: string;
}

const title = "Blog - Emmanuel Contreras, Arquitecto Digital";
const description = "Artículos sobre estrategia digital, desarrollo web y tecnología para ayudar a los negocios a construir activos digitales que generan resultados.";

const blogPostsCollection = collection(db, 'blogPosts');
const blogPostsSnapshot = await getDocs(blogPostsCollection);
const blogPosts: BlogPost[] = blogPostsSnapshot.docs.map(doc => ({ id: doc.id, ...(doc.data() as BlogPost) }));
---

<Layout title={title} description={description}>
    <section class="hero-interior">
        <h1 class="hero-interior__title">Blog de Arquitectura Digital</h1>
        <p class="text-lg max-w-3xl mx-auto mt-4">
            Ideas, estrategias y análisis sobre cómo construir activos digitales
            que generan resultados reales y medibles.
        </p>
    </section>

    <section class="page-section">
        <div class="container">
            <div class="portfolio-grid">
                {blogPosts.map(post => (
                    <a href={`/blog/${post.id}`} class="card">
                        <img src={post.imageUrl || ''} alt={post.title || 'Blog Post Image'} class="card__image">
                        <div class="card__content">
                            <h3 class="card__title">{post.title || 'Untitled Post'}</h3>
                            <p>{(post.content && post.content.substring(0, 100)) || 'No content available.'}...</p>
                        </div>
                    </a>
                ))}
            </div>
        </div>
    </section>
</Layout>
