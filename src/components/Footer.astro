---
// src/components/Footer.astro
import CallToAction from "./CallToAction.astro";
const currentYear = new Date().getFullYear();
---

<!-- Primero, el Llamado a la Acción -->
<CallToAction />

<!-- Luego, el pie de página principal -->
<footer class="footer" id="main-footer">
    <div class="container text-center">
        <div class="mb-6">
            <a
                href="/servicios"
                class="mx-3 hover:text-accent-cyan transition-colors"
                >Servicios</a
            >
            <a
                href="/caso-de-exito"
                class="mx-3 hover:text-accent-cyan transition-colors"
                >Casos de Éxito</a
            >
            <a
                href="/proceso"
                class="mx-3 hover:text-accent-cyan transition-colors">Proceso</a
            >
            <a
                href="/sobre-mi"
                class="mx-3 hover:text-accent-cyan transition-colors"
                >Sobre Mí</a
            >
            <a
                href="/contacto"
                class="mx-3 hover:text-accent-cyan transition-colors"
                >Contacto</a
            >
        </div>
        <p class="text-sm opacity-80">
            &copy; {currentYear} Emmanuel Contreras - Arquitecto Digital. Todos los
            derechos reservados.
        </p>
    </div>
</footer>
