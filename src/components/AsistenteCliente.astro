---
import { Image } from 'astro:assets';
import logo from '../assets/logo-emmanuel-contreras.png';

// Obtenemos la URL de la variable de entorno.
// Astro requiere el prefijo PUBLIC_ para exponerla al cliente.
const chatApiUrl = import.meta.env.PUBLIC_CHAT_API_URL;
---
<div id="cliente-fab" class="cliente-fab">
    <Image src={logo} alt="Asistente de Proyectos" class="cliente-fab__icon" />
    <svg xmlns="http://www.w3.org/2000/svg" class="cliente-fab__icon cliente-fab__icon--close hidden" viewBox="0 0 24 24" fill="currentColor">
        <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
    </svg>
</div>

<div id="cliente-chat-window" class="cliente-chat-window hidden" data-api-url={chatApiUrl}>
    <header class="cliente-chat-header">
        <h3 class="cliente-chat-header__title">Asistente de Proyectos</h3>
        <button id="cliente-close-btn" class="cliente-chat-header__close-btn">&times;</button>
    </header>
    <main id="cliente-messages" class="cliente-chat-messages">
        <div class="message message-ai">
            <p>¡Hola! Estoy aquí para ayudarte a definir los detalles de tu próximo gran proyecto. ¿En qué podemos empezar a trabajar?</p>
        </div>
    </main>
    <footer class="cliente-chat-footer">
        <form id="cliente-form" class="cliente-chat-form">
            <input type="text" id="cliente-input" placeholder="Describe tu proyecto..." class="cliente-chat-form__input" autocomplete="off">
            <button type="submit" class="cliente-chat-form__submit">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
                </svg>
            </button>
        </form>
    </footer>
</div>
<script is:inline src="/assets/app-asistente-cliente.js"></script>
