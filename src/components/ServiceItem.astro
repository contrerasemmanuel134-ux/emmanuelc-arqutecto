---
import { Image } from 'astro:assets';

interface Props {
  title: string;
  description: string;
  imageUrl: string;
  layout?: 'left' | 'right';
}

const { title, description, imageUrl, layout = 'left' } = Astro.props;

const layoutClasses = {
  container: layout === 'left' ? '' : 'md:flex-row-reverse',
  content: layout === 'left' ? 'md:pl-12' : 'md:pr-12',
};
---
<article class=`service-item-detailed ${layoutClasses.container}`>
    <div class="service-item-detailed__graphic">
        <Image
            src={imageUrl}
            alt={title}
            class="servicio-imagen"
            width={500}
            height={500}
            densities={[1, 1.5, 2]}
        />
    </div>
    <div class=`service-item-detailed__content ${layoutClasses.content}`>
        <h2 class="service-item-detailed__title">{title}</h2>
        <p class="service-item-detailed__description">{description}</p>
        <a href="/contacto" class="button button--primary mt-6">Solicitar Información</a>
    </div>
</article>
