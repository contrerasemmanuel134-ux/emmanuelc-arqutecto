---
// src/components/Logo.astro
import logoImage from "@/assets/logo-emmanuel-contreras.png";

export interface Props {
    class?: string;
}

const { class: className, ...rest } = Astro.props;
---

<img src={logoImage.src} alt="Emmanuel Contreras Logo" class:list={["logo-image", className]} {...rest} />

<style>
    .logo-image {
        /* You might want to adjust sizing here or in _navigation.css */
        width: 50px; /* Example size, adjust as needed */
        height: auto;
    }
</style>
